---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { descriptions } from '$lib/ProjectDescriptions';
import LingoHome from '$lib/screenshots/lingo/home.png';
import ApptitudeMain from '$lib/screenshots/apptitude/main.webp';
import BtonomicsMain from '$lib/screenshots/btonomics/main.webp';
import CubbyDashboard from '$lib/screenshots/cubby/dashboard.webp';
import CubbyGym from '$lib/screenshots/cubby/gym-workout.webp';
import CubbyCoffee from '$lib/screenshots/cubby/coffee.webp';

const archiveOrder = [
	'cancelninja',
	'roamichi',
	'eatyourmeds',
	'rankamate',
	'btonomics-wordpress',
	'appraize',
	'grumplr',
	'meetrics',
	'rinku',
	'wronged',
];
const archive = archiveOrder.map((slug) => ({ slug, ...descriptions[slug] }));

type ProjectFact = {
	label: string;
	value: string;
};

type FeaturedProject = {
	slug: string;
	img?: ImageMetadata;
	shots?: ImageMetadata[];
	kind: string;
	pos: string;
	stack: string;
	facts: ProjectFact[];
};

const featured: FeaturedProject[] = [
	{
		slug: 'cubby',
		kind: 'mobile',
		pos: 'top',
		stack: 'Go · SvelteKit · Postgres · Grafana Cloud',
		shots: [CubbyDashboard, CubbyGym, CubbyCoffee],
		facts: [
			{ label: 'Status', value: 'Active household app' },
			{ label: 'Problem', value: 'Daily routines scattered across memory, chat, and calendars' },
			{ label: 'Outcome', value: 'One dashboard for tasks, limits, bills, health, travel, and home logs' },
		],
	},
	{
		slug: 'lingo',
		img: LingoHome,
		kind: 'web',
		pos: 'center',
		stack: 'Go · htmx · Meilisearch · Grafana Cloud',
		facts: [
			{ label: 'Status', value: 'Live glossary and Public Service newbie guide' },
			{
				label: 'Problem',
				value:
					'New officers encounter abbreviations and workplace language before they have the context to understand them',
			},
			{
				label: 'Scope',
				value:
					'3,500+ entries across abbreviations, branded terms and workplace phrases; 222 newbie terms, 51 essentials and quiz practice',
			},
		],
	},
	{
		slug: 'apptitude',
		img: ApptitudeMain,
		kind: 'web',
		pos: 'top',
		stack: 'SvelteKit · PostgreSQL · Meilisearch · Axiom',
		facts: [
			{ label: 'Status', value: 'Live learning and decision-support platform' },
			{
				label: 'Problem',
				value:
					'People need different support when building technical knowledge and when accountable for a live decision',
			},
			{ label: 'Outcome', value: 'Guided learning paths for foundations; Consults for live decisions' },
		],
	},
	{
		slug: 'btonomics',
		img: BtonomicsMain,
		kind: 'web',
		pos: 'top',
		stack: 'Astro · Pagefind',
		facts: [
			{ label: 'Status', value: 'Static blog rebuild' },
			{ label: 'Problem', value: 'WordPress overhead for a focused renovation archive' },
			{ label: 'Outcome', value: 'Fast searchable HDB renovation notes by topic' },
		],
	},
];
---

<section aria-label="Projects" class="grid w-full justify-self-center text-center">
	<div id="project-list" class="grid w-full gap-y-20 text-start lg:gap-y-28">
		{
			featured.map((project, index) => {
				const meta = descriptions[project.slug];
				const domain = meta.url.replace(/^https?:\/\//, '').replace(/\/+$/, '');
				return (
					<a
						href={`/projects/${project.slug}`}
						class="group focus-visible:outline-accent grid items-stretch gap-7 text-start focus-visible:outline-2 focus-visible:outline-offset-6 lg:grid-cols-2 lg:gap-14">
						<div>
							{project.kind === 'mobile' ? (
								<div class="flex items-end justify-center gap-2 transition-transform duration-500 ease-out group-hover:scale-[1.02]">
									{(project.shots ?? []).map((shot, shotIndex) => (
										<div class="w-[30%] border border-white/10">
											<Image
												src={shot}
												alt={`${meta.name} screenshot ${shotIndex + 1}`}
												loading="lazy"
												class="block h-auto w-full object-cover"
											/>
										</div>
									))}
								</div>
							) : (
								project.img && (
									<div class="overflow-hidden border border-white/10 transition-colors group-hover:border-white/25">
										<Image
											src={project.img}
											alt={`${meta.name} screenshot`}
											loading="lazy"
											class="aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
											style={`object-position: ${project.pos};`}
										/>
									</div>
								)
							)}
						</div>
						<div class="flex flex-col">
							<div class="flex items-baseline gap-4">
								<span class="text-neutral-content/55 text-sm">{String(index + 1).padStart(2, '0')}</span>
								<h3 class="decoration-accent text-2xl font-bold tracking-tight decoration-4 underline-offset-4 transition-colors group-hover:underline lg:text-4xl">
									{meta.name}
								</h3>
							</div>
							<p class="text-neutral-content/75 mt-3 max-w-md text-sm leading-relaxed lg:text-base">{meta.subtitle}</p>
							<p class="text-inverse-muted-foreground mt-2 text-xs">{project.stack}</p>
							<dl class="mt-5 grid gap-2 border-y border-white/10 py-4">
								{project.facts.map((fact) => (
									<div class="grid gap-x-4 gap-y-0.5 sm:grid-cols-[5rem_1fr]">
										<dt class="text-inverse-muted-foreground font-mono text-[0.65rem] tracking-[0.16em] uppercase">
											{fact.label}
										</dt>
										<dd class="text-neutral-content/72 text-sm leading-relaxed">{fact.value}</dd>
									</div>
								))}
							</dl>
							<div class="text-neutral-content/60 mt-auto flex items-center justify-between gap-4 pt-4 text-xs">
								<span>{domain}</span>
								<span class="text-neutral-content/75 flex items-center gap-1 font-mono">
									Read case study
									<Icon name="chevron-right" class="size-3.5" />
								</span>
							</div>
						</div>
					</a>
				);
			})
		}
	</div>

	<section class="mt-20 w-full text-start lg:mt-28">
		<h3 class="text-4xl font-bold">Graveyard</h3>
		<p class="text-neutral-content/65 mt-3 max-w-xl text-sm lg:text-base">
			Retired projects, prototypes, and older builds that fed into current ones.
		</p>
		<dl class="mt-8 border-t border-white/15">
			{
				archive.slice(0, 3).map((item) => (
					<div class="grid gap-x-6 gap-y-1 border-b border-white/15 py-4 sm:grid-cols-[11rem_1fr_auto] sm:items-baseline">
						<dt class="text-sm font-semibold lg:text-base">{item.name}</dt>
						<dd>
							<span class="text-neutral-content/70 text-sm lg:text-base">{item.subtitle}</span>
							{item.stack && <span class="text-inverse-muted-foreground mt-0.5 block text-xs">{item.stack}</span>}
						</dd>
						<dd class="text-neutral-content/65 text-xs sm:text-right">{item.lineage ?? ''}</dd>
					</div>
				))
			}
		</dl>
		{
			archive.length > 3 && (
				<details class="archive-disclosure border-b border-white/15">
					<summary class="focus-visible:outline-accent text-neutral-content/65 hover:text-neutral-content flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 font-mono text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
						<span>
							<span class="archive-when-closed">Show</span>
							<span class="archive-when-open">Hide</span> {archive.length - 3} more retired builds
						</span>
						<Icon name="chevron-right" class="archive-chevron size-4 shrink-0 transition-transform" />
					</summary>
					<dl>
						{archive.slice(3).map((item) => (
							<div class="grid gap-x-6 gap-y-1 border-b border-white/15 py-4 sm:grid-cols-[11rem_1fr_auto] sm:items-baseline">
								<dt class="text-sm font-semibold lg:text-base">{item.name}</dt>
								<dd>
									<span class="text-neutral-content/70 text-sm lg:text-base">{item.subtitle}</span>
									{item.stack && <span class="text-inverse-muted-foreground mt-0.5 block text-xs">{item.stack}</span>}
								</dd>
								<dd class="text-neutral-content/65 text-xs sm:text-right">{item.lineage ?? ''}</dd>
							</div>
						))}
					</dl>
				</details>
			)
		}
	</section>
</section>

<style>
	.archive-disclosure summary::-webkit-details-marker {
		display: none;
	}

	.archive-when-open {
		display: none;
	}

	.archive-disclosure[open] .archive-when-closed {
		display: none;
	}

	.archive-disclosure[open] .archive-when-open {
		display: inline;
	}

	.archive-disclosure[open] .archive-chevron {
		transform: rotate(90deg);
	}
</style>
