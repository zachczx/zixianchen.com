---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const sectionLabel = headings.length
	? `On this page · ${headings.length} ${headings.length === 1 ? 'section' : 'sections'}`
	: 'On this page';
---

<div data-article-toc-root>
	<details data-article-toc-mobile class="article-contents border-base-content/10 mt-4 border-y px-5 sm:px-6 xl:px-14">
		<summary
			class="flex min-h-11 cursor-pointer list-none items-center gap-2 py-3 focus-visible:outline-2 focus-visible:outline-offset-2">
			<span class="contents-label shrink-0">Contents</span>
			<span class="contents-separator" aria-hidden="true">·</span>
			<span data-toc-current class="contents-current min-w-0 flex-1 truncate">{sectionLabel}</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="contents-chevron size-4 shrink-0"
				aria-hidden="true">
				<path d="m9 18 6-6-6-6"></path>
			</svg>
		</summary>
		<nav aria-label="Article contents" class="border-base-content/10 border-t py-2">
			<ol>
				{
					headings.map((heading) => (
						<li class:list={{ 'toc-mobile-h3': heading.depth === 3 }}>
							<a
								href={`#${heading.slug}`}
								data-toc-link
								data-toc-id={heading.slug}
								class="group flex min-h-11 items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-[-2px]">
								<span class="toc-link-marker size-3 shrink-0" aria-hidden="true">
									›
								</span>
								<span>{heading.text}</span>
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	</details>

	<aside data-article-toc-desktop hidden aria-labelledby="article-contents-heading">
		<h2 id="article-contents-heading" class="toc-heading">Contents</h2>
		<nav aria-label="Article contents">
			<ol>
				{
					headings.map((heading) => (
						<li class:list={{ 'toc-h2': heading.depth === 2, 'toc-h3': heading.depth === 3 }}>
							<a href={`#${heading.slug}`} data-toc-link data-toc-id={heading.slug}>
								{heading.text}
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	</aside>
</div>

<script>
	const tocRoot = document.querySelector<HTMLElement>('[data-article-toc-root]');

	if (tocRoot) {
		const article = document.querySelector<HTMLElement>('[data-article-content]');
		const mobileToc = tocRoot.querySelector<HTMLDetailsElement>('[data-article-toc-mobile]');
		const mobilePanel = mobileToc?.querySelector<HTMLElement>('nav');
		const mobileSummary = mobileToc?.querySelector<HTMLElement>('summary');
		const currentLabel = mobileToc?.querySelector<HTMLElement>('[data-toc-current]');
		const desktopToc = tocRoot.querySelector<HTMLElement>('[data-article-toc-desktop]');

		if (
			!(article instanceof HTMLElement) ||
			!article.matches('article.blog-prose') ||
			!mobileToc ||
			!mobilePanel ||
			!mobileSummary ||
			!currentLabel ||
			!desktopToc
		) {
			tocRoot.remove();
		} else {
			const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]'));
			const mobileLinks = Array.from(mobileToc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
			const desktopLinks = Array.from(desktopToc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
			const allLinks = [...desktopLinks, ...mobileLinks];
			const wideViewport = window.matchMedia('(min-width: 80rem)');
			const defaultLabel = currentLabel.textContent?.trim() || `${headings.length} sections`;
			let activeId: string | undefined;
			let frame: number | undefined;

			mobileToc.dataset.persistentToc = '';
			mobileToc.open = false;
			desktopToc.hidden = false;

			const keepLinkVisible = (container: HTMLElement, link: HTMLAnchorElement) => {
				const containerRect = container.getBoundingClientRect();
				const linkRect = link.getBoundingClientRect();
				const padding = 12;

				if (linkRect.top < containerRect.top + padding) {
					container.scrollTop -= containerRect.top + padding - linkRect.top;
				} else if (linkRect.bottom > containerRect.bottom - padding) {
					container.scrollTop += linkRect.bottom - (containerRect.bottom - padding);
				}
			};

			const setCurrent = (id?: string) => {
				if (activeId === id) return;
				activeId = id;

				for (const link of allLinks) {
					if (id && link.dataset.tocId === id) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				}

				const heading = id ? headings.find((candidate) => candidate.id === id) : undefined;
				currentLabel.textContent = heading?.textContent?.trim() || defaultLabel;

				if (wideViewport.matches && id) {
					const activeLink = desktopLinks.find((link) => link.dataset.tocId === id);
					if (activeLink) keepLinkVisible(desktopToc, activeLink);
				}

				if (mobileToc.open && id) {
					const activeLink = mobileLinks.find((link) => link.dataset.tocId === id);
					if (activeLink) keepLinkVisible(mobilePanel, activeLink);
				}
			};

			const syncCurrent = () => {
				const activationOffset = wideViewport.matches ? 72 : 96;
				let current: HTMLHeadingElement | undefined;

				for (const heading of headings) {
					if (heading.getBoundingClientRect().top <= activationOffset) current = heading;
					else break;
				}

				if (!current && window.scrollY < 2) current = headings[0];

				if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
					current = headings.at(-1);
				}
				setCurrent(current?.id);
			};

			const queueSync = () => {
				if (frame !== undefined) return;
				frame = window.requestAnimationFrame(() => {
					syncCurrent();
					frame = undefined;
				});
			};

			for (const link of allLinks) {
				link.addEventListener('click', () => {
					setCurrent(link.dataset.tocId);
					if (mobileToc.contains(link)) mobileToc.open = false;
				});
			}

			mobileToc.addEventListener('toggle', () => {
				if (!mobileToc.open || !activeId) return;
				const activeLink = mobileLinks.find((link) => link.dataset.tocId === activeId);
				if (activeLink) keepLinkVisible(mobilePanel, activeLink);
			});

			document.addEventListener('click', (event) => {
				if (mobileToc.open && !mobileToc.contains(event.target as Node)) mobileToc.open = false;
			});

			window.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !mobileToc.open) return;
				const hadFocus = mobileToc.contains(document.activeElement);
				mobileToc.open = false;
				if (hadFocus) mobileSummary.focus();
			});

			window.addEventListener('scroll', queueSync, { passive: true });
			window.addEventListener('resize', queueSync);
			window.addEventListener('hashchange', queueSync);
			wideViewport.addEventListener('change', () => {
				mobileToc.open = false;
				queueSync();
			});

			syncCurrent();
		}
	}
</script>

<style>
	/* Hallmark · component: marginalia contents rail · genre: editorial · theme: portfolio
	 * states: default · hover · focus · active · current-location
	 * contrast: pass (40–41) · mobile: pass (34, 49–56) · pre-emit critique: P4 H5 E4 S5 R5 V4
	 */
	[data-article-toc-root] {
		display: contents;
	}

	[data-article-toc-desktop] {
		display: none;
	}

	.article-contents summary::-webkit-details-marker {
		display: none;
	}

	.article-contents summary {
		color: var(--color-base-content);
		font-size: 1rem;
		line-height: 1.35;
	}

	.contents-label {
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.contents-separator {
		color: color-mix(in oklab, var(--color-base-content) 36%, transparent);
	}

	.contents-current {
		color: color-mix(in oklab, var(--color-base-content) 82%, transparent);
	}

	.contents-chevron {
		transition: transform var(--motion-duration-micro) var(--motion-ease-out);
	}

	.article-contents[open] .contents-chevron {
		transform: rotate(90deg);
	}

	.article-contents[data-persistent-toc] {
		position: sticky;
		z-index: 40;
		top: 2.75rem;
		background: color-mix(in oklab, var(--color-base-100) 96%, transparent);
		color: var(--color-base-content);
		backdrop-filter: blur(12px);
	}

	.article-contents[data-persistent-toc] nav {
		position: absolute;
		top: calc(100% - 1px);
		inset-inline: 0;
		max-height: min(50dvh, 28rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		border-block-end: 1px solid color-mix(in oklab, var(--color-base-content) 14%, transparent);
		background: var(--color-base-100);
		color: var(--color-base-content);
	}

	.article-contents ol,
	[data-article-toc-desktop] ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.article-contents .toc-mobile-h3 {
		margin-inline-start: 1rem;
	}

	.article-contents a {
		color: var(--color-base-content);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.4;
		padding-inline: 0.75rem;
		text-decoration: none;
		transition:
			color var(--motion-duration-micro) var(--motion-ease-out),
			opacity var(--motion-duration-micro) var(--motion-ease-out);
	}

	.article-contents .toc-link-marker {
		width: 0.125rem;
		height: 1rem;
		background: currentColor;
		font-size: 0;
		opacity: 0;
		transition: opacity var(--motion-duration-micro) var(--motion-ease-out);
	}

	.article-contents a[aria-current='location'],
	[data-article-toc-desktop] a[aria-current='location'] {
		color: var(--color-base-content);
		font-weight: 400;
	}

	.article-contents a[aria-current='location'] .toc-link-marker {
		color: var(--blog-night-accent);
		opacity: 1;
	}

	.article-contents a:active,
	[data-article-toc-desktop] a:active {
		opacity: 0.72;
	}

	.article-contents a:focus-visible,
	.article-contents summary:focus-visible,
	[data-article-toc-desktop] a:focus-visible {
		outline-color: var(--color-ring);
	}

	[data-article-toc-desktop] .toc-h3 {
		margin-inline-start: 1rem;
	}

	[data-article-toc-desktop] .toc-h2:not(:first-child) {
		margin-block-start: 0.5rem;
	}

	[data-article-toc-desktop] a {
		display: block;
		padding: 0.1875rem 0.75rem;
		color: color-mix(in oklab, var(--color-base-content) 82%, transparent);
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.35;
		text-decoration: none;
		transition:
			color var(--motion-duration-micro) var(--motion-ease-out),
			opacity var(--motion-duration-micro) var(--motion-ease-out);
	}

	[data-article-toc-desktop] .toc-h3 > a {
		color: color-mix(in oklab, var(--color-base-content) 74%, transparent);
		font-size: 0.8125rem;
	}

	[data-article-toc-desktop] a[aria-current='location'] {
		position: relative;
	}

	[data-article-toc-desktop] a[aria-current='location']::before {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: -0.75rem;
		width: 0.125rem;
		height: 1rem;
		background: var(--blog-night-accent);
		content: '';
		transform: translateY(-50%);
	}

	[data-article-toc-desktop] a:focus-visible {
		outline: 2px solid var(--color-ring);
		outline-offset: -2px;
	}

	@media (hover: hover) and (pointer: fine) {
		.article-contents a:hover,
		[data-article-toc-desktop] a:hover {
			color: var(--color-base-content);
		}

		.article-contents a:hover .toc-link-marker {
			opacity: 0.7;
		}
	}

	:global(article.blog-prose h2[id]),
	:global(article.blog-prose h3[id]) {
		scroll-margin-top: 6.5rem;
	}

	@media (min-width: 80rem) {
		.article-contents[data-persistent-toc] {
			display: none;
		}

		[data-article-toc-desktop] {
			display: block;
			position: fixed;
			z-index: 30;
			top: 7.25rem;
			left: calc(50% + 26rem);
			width: min(19rem, calc(50vw - 26.5rem));
			max-height: calc(100vh - 8.75rem);
			overflow-y: auto;
			overscroll-behavior: contain;
			border-inline-start: 1px solid color-mix(in oklab, var(--color-base-content) 18%, transparent);
			background: var(--color-base-100);
			color: var(--color-base-content);
			padding: 0.75rem;
			scrollbar-width: thin;
		}

		.toc-heading {
			margin: 0 0 0.5rem;
			padding-inline: 0.75rem;
			color: var(--color-base-content);
			font-size: 0.875rem;
			font-weight: 600;
			letter-spacing: 0.06em;
		}

		:global(article.blog-prose h2[id]),
		:global(article.blog-prose h3[id]) {
			scroll-margin-top: 5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contents-chevron,
		.article-contents a,
		.article-contents .toc-link-marker,
		[data-article-toc-desktop] a {
			transition-duration: 0ms;
		}
	}
</style>
