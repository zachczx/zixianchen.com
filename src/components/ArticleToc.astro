<div data-article-toc-root>
	<aside data-article-toc-desktop hidden aria-label="Article contents">
		<div class="toc-heading">Contents</div>
		<nav aria-label="Article contents" data-toc-desktop-list></nav>
	</aside>
</div>

<script>
	const tocRoot = document.querySelector<HTMLElement>('[data-article-toc-root]');
	const article = document.querySelector<HTMLElement>('article.blog-prose');
	const mobileToc = document.querySelector<HTMLDetailsElement>('.article-contents');

	if (!tocRoot || !article || !mobileToc) {
		tocRoot?.remove();
	} else {
		const sourceList = mobileToc.querySelector<HTMLOListElement>('nav > ol');
		const mobilePanel = mobileToc.querySelector<HTMLElement>('nav');
		const mobileSummary = mobileToc.querySelector<HTMLElement>('summary');
		const currentLabel = mobileSummary?.querySelector<HTMLElement>('span');
		const desktopToc = tocRoot.querySelector<HTMLElement>('[data-article-toc-desktop]');
		const desktopList = tocRoot.querySelector<HTMLElement>('[data-toc-desktop-list]');
		const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]'));
		const mobileLinks = Array.from(mobileToc.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'));

		if (
			headings.length <= 1 ||
			mobileLinks.length <= 1 ||
			!sourceList ||
			!mobilePanel ||
			!mobileSummary ||
			!currentLabel ||
			!desktopToc ||
			!desktopList
		) {
			mobileToc.remove();
			tocRoot.remove();
		} else {
			mobileToc.dataset.persistentToc = '';
			mobileToc.open = false;

			const defaultLabel = currentLabel.textContent?.trim() || `Contents · ${mobileLinks.length} sections`;
			desktopList.append(sourceList.cloneNode(true));
			desktopToc.hidden = false;

			const desktopLinks = Array.from(desktopToc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
			const wideViewport = window.matchMedia('(min-width: 80rem)');
			let activeId: string | undefined;
			let frame: number | undefined;

			const getLinkId = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.replace(/^#/, ''));
			const allLinks = [...desktopLinks, ...mobileLinks];

			const keepLinkVisible = (container: HTMLElement, link: HTMLAnchorElement) => {
				const containerRect = container.getBoundingClientRect();
				const linkRect = link.getBoundingClientRect();
				const padding = 12;

				if (linkRect.top < containerRect.top + padding) {
					container.scrollTop -= containerRect.top + padding - linkRect.top;
				} else if (linkRect.bottom > containerRect.bottom - padding) {
					container.scrollTop += linkRect.bottom - (containerRect.bottom - padding);
				}
			};

			const setCurrent = (id?: string) => {
				if (activeId === id) return;
				activeId = id;

				for (const link of allLinks) {
					if (id && getLinkId(link) === id) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				}

				const heading = id ? headings.find((candidate) => candidate.id === id) : undefined;
				currentLabel.textContent = heading?.textContent?.trim() ? `Contents · ${heading.textContent.trim()}` : defaultLabel;

				if (wideViewport.matches && id) {
					const activeLink = desktopLinks.find((link) => getLinkId(link) === id);
					if (activeLink) keepLinkVisible(desktopToc, activeLink);
				}

				if (mobileToc.open && id) {
					const activeLink = mobileLinks.find((link) => getLinkId(link) === id);
					if (activeLink) keepLinkVisible(mobilePanel, activeLink);
				}
			};

			const syncCurrent = () => {
				const activationOffset = wideViewport.matches ? 72 : 96;
				let current: HTMLHeadingElement | undefined;

				for (const heading of headings) {
					if (heading.getBoundingClientRect().top <= activationOffset) current = heading;
					else break;
				}

				if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
					current = headings.at(-1);
				}
				setCurrent(current?.id);
			};

			const queueSync = () => {
				if (frame !== undefined) return;
				frame = window.requestAnimationFrame(() => {
					syncCurrent();
					frame = undefined;
				});
			};

			for (const link of allLinks) {
				link.addEventListener('click', () => {
					setCurrent(getLinkId(link));
					if (mobileToc.contains(link)) mobileToc.open = false;
				});
			}

			mobileToc.addEventListener('toggle', () => {
				if (!mobileToc.open || !activeId) return;
				const activeLink = mobileLinks.find((link) => getLinkId(link) === activeId);
				if (activeLink) keepLinkVisible(mobilePanel, activeLink);
			});

			document.addEventListener('click', (event) => {
				if (mobileToc.open && !mobileToc.contains(event.target as Node)) mobileToc.open = false;
			});

			window.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !mobileToc.open) return;
				const hadFocus = mobileToc.contains(document.activeElement);
				mobileToc.open = false;
				if (hadFocus) mobileSummary.focus();
			});

			window.addEventListener('scroll', queueSync, { passive: true });
			window.addEventListener('resize', queueSync);
			window.addEventListener('hashchange', queueSync);
			wideViewport.addEventListener('change', () => {
				mobileToc.open = false;
				queueSync();
			});

			syncCurrent();
		}
	}
</script>

<style>
	[data-article-toc-root] {
		display: contents;
	}

	[data-article-toc-desktop] {
		display: none;
	}

	:global(.article-contents[data-persistent-toc]) {
		position: sticky;
		z-index: 40;
		top: 2.75rem;
		background: color-mix(in oklab, var(--color-base-200) 94%, transparent);
		backdrop-filter: blur(12px);
	}

	:global(.article-contents[data-persistent-toc] summary > span) {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.article-contents[data-persistent-toc] nav) {
		position: absolute;
		top: calc(100% - 1px);
		inset-inline: 0;
		max-height: min(65vh, 32rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		background: var(--color-base-200);
		box-shadow: 0 1rem 2rem color-mix(in oklab, black 22%, transparent);
	}

	:global(.article-contents[data-persistent-toc] a[aria-current='location']),
	[data-article-toc-desktop] :global(a[aria-current='location']) {
		color: var(--color-base-content);
	}

	:global(.article-contents[data-persistent-toc] a[aria-current='location'] > span:last-child),
	[data-article-toc-desktop] :global(a[aria-current='location'] > span:last-child) {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.25rem;
	}

	[data-article-toc-desktop] :global(ol) {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	[data-article-toc-desktop] :global(li.ml-6) {
		margin-inline-start: 0.75rem;
	}

	[data-article-toc-desktop] :global(a) {
		display: block;
		min-height: 0;
		padding: 0.3rem 0.5rem;
		color: color-mix(in oklab, var(--color-base-content) 52%, transparent);
		font-size: 0.75rem;
		line-height: 1.35;
		text-decoration: none;
	}

	[data-article-toc-desktop] :global(a > span:first-child) {
		display: none;
	}

	[data-article-toc-desktop] :global(a:hover),
	[data-article-toc-desktop] :global(a:focus-visible) {
		color: var(--color-base-content);
	}

	[data-article-toc-desktop] :global(a:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
	}

	:global(article.blog-prose h2[id]),
	:global(article.blog-prose h3[id]) {
		scroll-margin-top: 6.5rem;
	}

	@media (min-width: 80rem) {
		:global(.article-contents[data-persistent-toc]) {
			display: none;
		}

		[data-article-toc-desktop] {
			display: block;
			position: fixed;
			z-index: 30;
			top: 7.25rem;
			left: calc(50% + 26rem);
			width: min(17rem, calc(50vw - 27.5rem));
			max-height: calc(100vh - 8.75rem);
			overflow-y: auto;
			overscroll-behavior: contain;
			border-inline-start: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
			padding-inline-start: 0.75rem;
			font-family: var(--font-mono);
			scrollbar-width: thin;
		}

		.toc-heading {
			margin-bottom: 0.5rem;
			padding-inline: 0.5rem;
			color: color-mix(in oklab, var(--color-base-content) 72%, transparent);
			font-size: 0.6875rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		:global(article.blog-prose h2[id]),
		:global(article.blog-prose h3[id]) {
			scroll-margin-top: 5rem;
		}
	}
</style>
