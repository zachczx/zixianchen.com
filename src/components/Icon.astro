---
interface Props {
	name:
		| 'house'
		| 'circle-user-round'
		| 'panels-top-left'
		| 'notebook-text'
		| 'send'
		| 'linkedin'
		| 'github'
		| 'search'
		| 'x'
		| 'chevron-right'
		| 'chevron-left'
		| 'arrow-left'
		| 'external-link';
	class?: string;
	ariaHidden?: boolean;
}

const { name, class: className = '', ariaHidden = true } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden={ariaHidden ? 'true' : undefined}>
	{
		name === 'house' && (
			<>
				<>
					<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
					<path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
				</>
			</>
		)
	}
	{
		name === 'circle-user-round' && (
			<>
				<>
					<path d="M18 20a6 6 0 0 0-12 0" />
					<circle cx="12" cy="10" r="4" />
					<circle cx="12" cy="12" r="10" />
				</>
			</>
		)
	}
	{
		name === 'panels-top-left' && (
			<>
				<>
					<rect width="18" height="18" x="3" y="3" rx="2" />
					<path d="M3 9h18" />
					<path d="M9 21V9" />
				</>
			</>
		)
	}
	{
		name === 'notebook-text' && (
			<>
				<>
					<path d="M2 6h4" />
					<path d="M2 10h4" />
					<path d="M2 14h4" />
					<path d="M2 18h4" />
					<rect width="16" height="20" x="4" y="2" rx="2" />
					<path d="M9.5 8h5" />
					<path d="M9.5 12H16" />
					<path d="M9.5 16H14" />
				</>
			</>
		)
	}
	{
		name === 'send' && (
			<>
				<>
					<path d="m22 2-7 20-4-9-9-4Z" />
					<path d="M22 2 11 13" />
				</>
			</>
		)
	}
	{
		name === 'linkedin' && (
			<>
				<>
					<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
					<rect width="4" height="12" x="2" y="9" />
					<circle cx="4" cy="4" r="2" />
				</>
			</>
		)
	}
	{
		name === 'github' && (
			<>
				<>
					<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7A5.4 5.4 0 0 0 19.22 4 5.07 5.07 0 0 0 19.13.5S17.95.14 15 1.85a13.38 13.38 0 0 0-7 0C5.05.14 3.87.5 3.87.5A5.07 5.07 0 0 0 3.78 4a5.4 5.4 0 0 0-1.5 3.5c0 5.42 3.44 6.64 6.72 7A4.8 4.8 0 0 0 8 18v4" />
					<path d="M8 19c-3 .92-5-1.5-5-1.5" />
				</>
			</>
		)
	}
	{
		name === 'search' && (
			<>
				<>
					<path d="m21 21-4.34-4.34" />
					<circle cx="11" cy="11" r="8" />
				</>
			</>
		)
	}
	{
		name === 'x' && (
			<>
				<>
					<path d="M18 6 6 18" />
					<path d="m6 6 12 12" />
				</>
			</>
		)
	}
	{name === 'chevron-right' && <path d="m9 18 6-6-6-6" />}
	{name === 'chevron-left' && <path d="m15 18-6-6 6-6" />}
	{
		name === 'arrow-left' && (
			<>
				<>
					<path d="m12 19-7-7 7-7" />
					<path d="M19 12H5" />
				</>
			</>
		)
	}
	{
		name === 'external-link' && (
			<>
