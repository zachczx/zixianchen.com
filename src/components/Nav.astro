---
interface Props {
	navCurrent: string;
	pathName?: string;
	trackSections?: boolean;
}

type ActiveRule =
	| { type: 'hash'; key: string }
	| { type: 'path'; key: string }
	| { type: 'prefix'; key: string }
	| { type: 'prefixOrHash'; key: string; hash: string }
	| { type: 'none' };

type Link = {
	href: string;
	mobileHref?: string;
	label: string;
	active: ActiveRule;
};

const { navCurrent, pathName = '/', trackSections = false } = Astro.props;
const links = [
	{ href: '/#header', mobileHref: '/', label: 'Home', active: { type: 'hash', key: 'header' } },
	{ href: '/#about', label: 'About', active: { type: 'hash', key: 'about' } },
	{ href: '/#projects', label: 'Projects', active: { type: 'hash', key: 'projects' } },
	{
		href: '/blog',
		label: 'Blog',
		active: { type: 'prefixOrHash', key: '/blog', hash: 'musings' },
	},
] as const satisfies readonly Link[];

function isActive(rule: ActiveRule): boolean {
	if (rule.type === 'hash') return navCurrent === rule.key;
	if (rule.type === 'path') return pathName === rule.key;
	if (rule.type === 'prefix') return pathName.startsWith(rule.key);
	if (rule.type === 'prefixOrHash') return pathName.startsWith(rule.key) || navCurrent === rule.hash;
	return false;
}

function ariaCurrent(rule: ActiveRule, active: boolean): 'location' | 'page' | undefined {
	if (!active) return undefined;
	if (rule.type === 'hash') return 'location';
	if (rule.type === 'prefixOrHash' && !pathName.startsWith(rule.key)) return 'location';
	return 'page';
}

const mobileLinks = links.slice(0, 5);
---

<div data-site-nav data-path-name={pathName} data-track-sections={trackSections ? 'true' : 'false'}>
	<nav aria-label="Primary" style="view-transition-name: navrail;" class="fixed inset-x-0 top-0 z-50 border-b">
		<div class="relative flex min-h-11 w-full items-center justify-center px-4 sm:px-6 lg:px-8">
			<a
				href="/"
				aria-label="Home | Zixian Chen"
				class="top-nav-brand focus-visible:outline-accent absolute left-4 inline-flex min-h-11 items-center font-sans text-sm font-semibold tracking-tight whitespace-nowrap transition-colors focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] sm:left-6 lg:left-8">
				Zixian Chen
			</a>
			<div class="hidden min-w-0 items-center justify-center gap-1 lg:flex" data-nav-links="desktop">
				{
					links.map((item) => {
						const active = isActive(item.active);
						return (
							<a
								href={item.href}
								aria-current={ariaCurrent(item.active, active)}
								data-nav-link
								data-active-rule={item.active.type}
								data-active-key={'key' in item.active ? item.active.key : undefined}
								data-active-hash={'hash' in item.active ? item.active.hash : undefined}
								data-active={active ? 'true' : 'false'}
								class:list={[
									'top-nav-link focus-visible:outline-accent relative inline-flex min-h-11 items-center justify-center px-3 font-sans text-sm whitespace-nowrap transition-colors focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px]',
									active ? 'font-semibold' : '',
								]}>
								{item.label}
							</a>
						);
					})
				}
			</div>
			<div class="flex items-center justify-end gap-1 lg:hidden" data-nav-links="mobile">
				{
					mobileLinks.map((link) => {
						const active = isActive(link.active);
						return (
							<a
								href={'mobileHref' in link ? link.mobileHref : link.href}
								aria-current={ariaCurrent(link.active, active)}
								data-nav-link
								data-active-rule={link.active.type}
								data-active-key={'key' in link.active ? link.active.key : undefined}
								data-active-hash={'hash' in link.active ? link.active.hash : undefined}
								data-active={active ? 'true' : 'false'}
								class:list={[
									'top-nav-link focus-visible:outline-accent relative inline-flex min-h-11 shrink-0 items-center justify-center px-1 font-sans text-xs whitespace-nowrap transition-colors focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px]',
									active ? 'font-semibold' : '',
								]}>
								{link.label}
							</a>
						);
					})
				}
			</div>
		</div>
	</nav>
</div>

<script>
	import { waapi } from 'animejs/waapi';

	type NavTone = 'light' | 'dark';
	type HomeTone = 'day' | 'night';
	const toneProperties = ['--nav-surface', '--nav-overlay', '--nav-ink', '--nav-muted', '--nav-rule'] as const;
	const homeToneProperties = [
		'--home-surface',
		'--home-card',
		'--home-content',
		'--home-muted',
		'--home-overlay',
	] as const;
	type ToneProperty = (typeof toneProperties)[number];
	type HomeToneProperty = (typeof homeToneProperties)[number];
	const trackedRoots = Array.from(
		document.querySelectorAll<HTMLElement>('[data-site-nav][data-track-sections="true"]'),
	);
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const canAnimateTone = trackedRoots.length > 0 && !reducedMotion && 'registerProperty' in CSS;

	if (canAnimateTone) {
		for (const property of [...toneProperties, ...homeToneProperties]) {
			try {
				CSS.registerProperty({ name: property, syntax: '<color>', inherits: true, initialValue: 'transparent' });
			} catch {
				// The property may already be registered after a view transition.
			}
		}
	}

	for (const root of trackedRoots) {
		const pathName = root.dataset.pathName ?? '/';
		const sections = Array.from(document.querySelectorAll<HTMLElement>('.navItem'));
		const nav = root.querySelector<HTMLElement>('nav');
		const darkSurfaceSections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-tone-section="dark"]'));
		const nightStart = darkSurfaceSections[0];
		const homeRoot = nightStart ? document.querySelector<HTMLElement>('main') : null;
		const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
		let frame: number | undefined;
		let toneAnimation: ReturnType<typeof waapi.animate> | undefined;
		let homeToneAnimation: ReturnType<typeof waapi.animate> | undefined;
		let toneAnimationVersion = 0;
		let homeToneAnimationVersion = 0;
		let toneInitialized = false;
		let dayPalette: Record<HomeToneProperty, string> | undefined;
		let nightPalette: Record<HomeToneProperty, string> | undefined;

		const readTone = (): Record<ToneProperty, string> => {
			const styles = getComputedStyle(root);
			return Object.fromEntries(
				toneProperties.map((property) => [property, styles.getPropertyValue(property).trim()]),
			) as Record<ToneProperty, string>;
		};

		const readHomeTone = (): Record<HomeToneProperty, string> => {
			if (!homeRoot) throw new Error('Homepage tone root is unavailable');
			const styles = getComputedStyle(homeRoot);
			return Object.fromEntries(
				homeToneProperties.map((property) => [property, styles.getPropertyValue(property).trim()]),
			) as Record<HomeToneProperty, string>;
		};

		const setHomePalette = (palette: Record<HomeToneProperty, string>) => {
			if (!homeRoot) return;
			for (const property of homeToneProperties) {
				homeRoot.style.setProperty(property, palette[property]);
			}
		};

		if (homeRoot && nightStart) {
			const colorProbe = document.createElement('span');
			colorProbe.style.cssText = 'position:absolute;width:0;height:0;visibility:hidden;pointer-events:none;';
			homeRoot.appendChild(colorProbe);
			const resolveHomeColor = (property: string) => {
				colorProbe.style.color = `var(${property})`;
				return getComputedStyle(colorProbe).color;
			};

			const dayContent = resolveHomeColor('--color-base-content');
			dayPalette = {
				'--home-surface': resolveHomeColor('--color-base-200'),
				'--home-card': resolveHomeColor('--color-base-100'),
				'--home-content': dayContent,
				'--home-muted': resolveHomeColor('--color-muted-foreground'),
				'--home-overlay': dayContent,
			};
			nightPalette = {
				'--home-surface': resolveHomeColor('--color-night-background'),
				'--home-card': resolveHomeColor('--color-night-background'),
				'--home-content': resolveHomeColor('--color-night-content'),
				'--home-muted': resolveHomeColor('--color-night-muted-foreground'),
				'--home-overlay': resolveHomeColor('--color-night-overlay'),
			};
			colorProbe.remove();

			const initialTone: HomeTone =
				nightStart.getBoundingClientRect().top <= window.innerHeight * 0.45 ? 'night' : 'day';
			setHomePalette(initialTone === 'night' ? nightPalette : dayPalette);
			homeRoot.dataset.homeTone = initialTone;
			homeRoot.dataset.homeColorsReady = 'true';
		}

		const ruleIsActive = (link: HTMLAnchorElement, current: string) => {
			const rule = link.dataset.activeRule;
			const key = link.dataset.activeKey ?? '';
			if (rule === 'hash') return current === key;
			if (rule === 'path') return pathName === key;
			if (rule === 'prefix') return pathName.startsWith(key);
			if (rule === 'prefixOrHash') return pathName.startsWith(key) || current === link.dataset.activeHash;
			return false;
		};

		const applyActive = (current: string) => {
			for (const link of links) {
				const active = ruleIsActive(link, current);
				link.dataset.active = active ? 'true' : 'false';
				link.classList.toggle('font-semibold', active);

				if (!active) {
					link.removeAttribute('aria-current');
				} else if (link.dataset.activeRule === 'hash') {
					link.setAttribute('aria-current', 'location');
				} else if (link.dataset.activeRule === 'prefixOrHash' && !pathName.startsWith(link.dataset.activeKey ?? '')) {
					link.setAttribute('aria-current', 'location');
				} else {
					link.setAttribute('aria-current', 'page');
				}
			}
		};

		const applyNavTone = (tone: NavTone) => {
			if (!toneInitialized) {
				root.dataset.navTone = tone;
				toneInitialized = true;
				return;
			}

			if (root.dataset.navTone === tone) return;

			if (!canAnimateTone) {
				root.dataset.navTone = tone;
				return;
			}

			const current = readTone();
			toneAnimation?.cancel();
			const palette = tone === 'dark' ? 'night' : 'day';
			const version = ++toneAnimationVersion;
			root.dataset.navTone = tone;

			const animation = waapi.animate(root, {
				'--nav-surface': [current['--nav-surface'], `var(--nav-${palette}-surface)`],
				'--nav-overlay': [current['--nav-overlay'], `var(--nav-${palette}-overlay)`],
				'--nav-ink': [current['--nav-ink'], `var(--nav-${palette}-ink)`],
				'--nav-muted': [current['--nav-muted'], `var(--nav-${palette}-muted)`],
				'--nav-rule': [current['--nav-rule'], `var(--nav-${palette}-rule)`],
				duration: 300,
				ease: 'linear',
			});
			toneAnimation = animation;

			void animation.then(() => {
				if (version !== toneAnimationVersion) return;
				animation.cancel();
				toneAnimation = undefined;
			});
		};

		const applyHomeTone = (tone: HomeTone) => {
			if (!homeRoot || !dayPalette || !nightPalette || homeRoot.dataset.homeTone === tone) return;
			const palette = tone === 'night' ? nightPalette : dayPalette;
			const navTone: NavTone = tone === 'night' ? 'dark' : 'light';
			homeRoot.dataset.homeTone = tone;

			if (!canAnimateTone) {
				homeToneAnimation?.cancel();
				homeToneAnimation = undefined;
				setHomePalette(palette);
				applyNavTone(navTone);
				return;
			}

			const current = readHomeTone();
			homeToneAnimation?.cancel();
			const version = ++homeToneAnimationVersion;
			const animation = waapi.animate(homeRoot, {
				'--home-surface': [current['--home-surface'], palette['--home-surface']],
				'--home-card': [current['--home-card'], palette['--home-card']],
				'--home-content': [current['--home-content'], palette['--home-content']],
				'--home-muted': [current['--home-muted'], palette['--home-muted']],
				'--home-overlay': [current['--home-overlay'], palette['--home-overlay']],
				duration: 300,
				ease: 'linear',
			});
			homeToneAnimation = animation;
			applyNavTone(navTone);

			void animation.then(() => {
				if (version !== homeToneAnimationVersion) return;
				animation.cancel();
				homeToneAnimation = undefined;
				setHomePalette(palette);
			});
		};

		const syncHomeTone = () => {
			if (!nightStart || !homeRoot) return;
			const isNight = nightStart.getBoundingClientRect().top <= window.innerHeight * 0.45;
			applyHomeTone(isNight ? 'night' : 'day');
		};

		const syncNavTone = () => {
			if (!nav) return;
			if (homeRoot?.dataset.homeTone) {
				applyNavTone(homeRoot.dataset.homeTone === 'night' ? 'dark' : 'light');
				return;
			}
			if (darkSurfaceSections.length === 0) return;
			const navBottom = nav.getBoundingClientRect().bottom;
			const target = document.elementFromPoint(window.innerWidth / 2, Math.min(window.innerHeight - 1, navBottom + 1));
			const isDark = Boolean(target?.closest('[data-nav-tone-section="dark"]'));
			applyNavTone(isDark ? 'dark' : 'light');
		};

		const syncCurrentSection = () => {
			const viewportAnchor = window.innerHeight * 0.4;
			let current = sections.find((section) => {
				const rect = section.getBoundingClientRect();
				return rect.top <= viewportAnchor && rect.bottom > viewportAnchor;
			});

			if (!current) {
				current = sections.reduce<{ section: HTMLElement; distance: number } | undefined>((nearest, section) => {
					const rect = section.getBoundingClientRect();
					const distance = Math.min(Math.abs(rect.top - viewportAnchor), Math.abs(rect.bottom - viewportAnchor));
					return !nearest || distance < nearest.distance ? { section, distance } : nearest;
				}, undefined)?.section;
			}

			applyActive(current?.id ?? 'header');
			syncHomeTone();
			syncNavTone();
			frame = undefined;
		};

		const queueSync = () => {
			if (frame !== undefined) return;
			frame = window.requestAnimationFrame(syncCurrentSection);
		};

		syncCurrentSection();
		window.addEventListener('scroll', queueSync, { passive: true });
		window.addEventListener('resize', queueSync);
		window.addEventListener('hashchange', queueSync);
	}
</script>

<style>
	:global(main[data-home-colors-ready='true']) {
		--color-base-100: var(--home-card);
		--color-base-200: var(--home-surface);
		--color-base-content: var(--home-content);
		--color-muted-foreground: var(--home-muted);
		--color-night-background: var(--home-surface);
		--color-night-content: var(--home-content);
		--color-night-muted-foreground: var(--home-muted);
		--color-night-overlay: var(--home-overlay);
	}

	[data-site-nav] {
		--nav-day-surface: var(--color-base-200);
		--nav-day-overlay: oklch(0% 0 0 / 0.03);
		--nav-day-ink: var(--color-base-content);
		--nav-day-muted: color-mix(in oklab, var(--color-base-content) 65%, transparent);
		--nav-day-rule: color-mix(in oklab, var(--color-base-content) 10%, transparent);
		--nav-night-surface: var(--color-neutral);
		--nav-night-overlay: oklch(100% 0 0 / 0.1);
		--nav-night-ink: var(--color-neutral-content);
		--nav-night-muted: color-mix(in oklab, var(--color-neutral-content) 65%, transparent);
		--nav-night-rule: color-mix(in oklab, var(--color-neutral-content) 16%, transparent);
		--nav-surface: var(--nav-day-surface);
		--nav-overlay: var(--nav-day-overlay);
		--nav-ink: var(--nav-day-ink);
		--nav-muted: var(--nav-day-muted);
		--nav-rule: var(--nav-day-rule);
	}

	[data-site-nav][data-nav-tone='dark'] {
		--nav-surface: var(--nav-night-surface);
		--nav-overlay: var(--nav-night-overlay);
		--nav-ink: var(--nav-night-ink);
		--nav-muted: var(--nav-night-muted);
		--nav-rule: var(--nav-night-rule);
	}

	[data-site-nav] nav {
		border-color: var(--nav-rule);
		background-color: var(--nav-surface);
		background-image: linear-gradient(var(--nav-overlay), var(--nav-overlay));
	}

	[data-site-nav] .top-nav-link {
		color: var(--nav-muted);
	}

	[data-site-nav] .top-nav-brand {
		color: var(--nav-ink);
	}

	[data-site-nav] .top-nav-link:hover,
	[data-site-nav] .top-nav-link[data-active='true'],
	[data-site-nav] .top-nav-brand:hover {
		color: var(--nav-ink);
	}
</style>
