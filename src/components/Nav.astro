---
import Icon from './Icon.astro';

interface Props {
	navCurrent: string;
	pathName?: string;
	trackSections?: boolean;
}

type ActiveRule =
	| { type: 'hash'; key: string }
	| { type: 'path'; key: string }
	| { type: 'prefix'; key: string }
	| { type: 'prefixOrHash'; key: string; hash: string }
	| { type: 'none' };

type Link = {
	href: string;
	mobileHref?: string;
	label: string;
	icon: Parameters<typeof Icon>[0] extends never ? never : string;
	active: ActiveRule;
};

const { navCurrent, pathName = '/', trackSections = false } = Astro.props;
const links = [
	{ href: '/#header', mobileHref: '/', label: 'Home', icon: 'house', active: { type: 'hash', key: 'header' } },
	{ href: '/#about', label: 'About', icon: 'circle-user-round', active: { type: 'hash', key: 'about' } },
	{ href: '/#projects', label: 'Projects', icon: 'panels-top-left', active: { type: 'hash', key: 'projects' } },
	{
		href: '/blog',
		label: 'Blog',
		icon: 'notebook-text',
		active: { type: 'prefixOrHash', key: '/blog', hash: 'musings' },
	},
	{ href: '/contact', label: 'Contact', icon: 'send', active: { type: 'path', key: '/contact' } },
	{ href: 'https://www.linkedin.com/in/zixianchen/', label: 'LinkedIn', icon: 'linkedin', active: { type: 'none' } },
	{
		href: 'https://github.com/zachczx?tab=repositories',
		label: 'GitHub',
		icon: 'github',
		active: { type: 'none' },
	},
] as const satisfies readonly Link[];

function isActive(rule: ActiveRule): boolean {
	if (rule.type === 'hash') return navCurrent === rule.key;
	if (rule.type === 'path') return pathName === rule.key;
	if (rule.type === 'prefix') return pathName.startsWith(rule.key);
	if (rule.type === 'prefixOrHash') return pathName.startsWith(rule.key) || navCurrent === rule.hash;
	return false;
}

function ariaCurrent(rule: ActiveRule, active: boolean): 'location' | 'page' | undefined {
	if (!active) return undefined;
	if (rule.type === 'hash') return 'location';
	if (rule.type === 'prefixOrHash' && !pathName.startsWith(rule.key)) return 'location';
	return 'page';
}

const mobileLinks = links.slice(0, 5);
---

<div data-site-nav data-path-name={pathName} data-track-sections={trackSections ? 'true' : 'false'}>
	<nav
		aria-label="Primary"
		class="z-50 grid h-fit w-full justify-center px-4 transition-all duration-300 ease-out xl:fixed xl:bottom-2">
		<div
			style="view-transition-name: navdock;"
			class="hidden h-20 w-fit min-w-120 items-center justify-center justify-self-center rounded border border-gray-400 bg-gray-900 px-2 shadow-sm backdrop-blur-md transition-all duration-300 ease-out xl:relative xl:flex">
			{
				links.map((item, index) => {
					const active = isActive(item.active);
					return (
						<>
							{index === 4 && <div class="mx-4 h-10/12 w-0.5 bg-white/30"></div>}
							<a
								href={item.href}
								aria-label={item.label}
								aria-current={ariaCurrent(item.active, active)}
								data-nav-link
								data-nav-kind="dock"
								data-active-rule={item.active.type}
								data-active-key={'key' in item.active ? item.active.key : undefined}
								data-active-hash={'hash' in item.active ? item.active.hash : undefined}
								class="dock group/dock focus-visible:outline-accent relative bg-transparent no-underline transition-all duration-100 ease-linear hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-4">
								<div
									data-nav-active-target
									class:list={[
										'relative flex items-center justify-center rounded-sm border transition-all duration-100 ease-linear',
										active
											? 'border-accent bg-accent text-neutral'
											: 'border-white/15 bg-white/10 text-white/80 group-hover/dock:border-white/30 group-hover/dock:bg-white/15 group-hover/dock:text-white',
									]}>
									<Icon name={item.icon as any} />
									<span class="bg-neutral pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-2 w-max -translate-x-1/2 rounded-xs px-2 py-1 font-mono text-xs font-bold whitespace-nowrap text-white/90 opacity-0 transition-opacity duration-100 group-hover/dock:visible group-hover/dock:opacity-100 group-focus-visible/dock:visible group-focus-visible/dock:opacity-100">
										{item.label}
									</span>
								</div>
							</a>
						</>
					);
				})
			}
		</div>
	</nav>

	<nav
		aria-label="Site"
		class="border-base-content/10 bg-base-100/95 fixed inset-x-0 bottom-0 z-50 grid grid-cols-5 border-t px-2 pt-1.5 pb-[calc(0.375rem+env(safe-area-inset-bottom))] font-mono text-xs tracking-wide uppercase backdrop-blur xl:hidden">
		{
			mobileLinks.map((link) => {
				const active = isActive(link.active);
				return (
					<a
						href={'mobileHref' in link ? link.mobileHref : link.href}
						aria-current={ariaCurrent(link.active, active)}
						data-nav-link
						data-nav-kind="mobile"
						data-active-rule={link.active.type}
						data-active-key={'key' in link.active ? link.active.key : undefined}
						data-active-hash={'hash' in link.active ? link.active.hash : undefined}
						class:list={[
							'decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center justify-center px-1 text-center decoration-2 underline-offset-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-0',
							active ? 'text-base-content underline' : 'text-muted-foreground hover:text-base-content',
						]}>
						{link.label}
					</a>
				);
			})
		}
	</nav>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-site-nav][data-track-sections="true"]')) {
		const pathName = root.dataset.pathName ?? '/';
		const sections = Array.from(document.querySelectorAll<HTMLElement>('.navItem'));
		const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
		let frame: number | undefined;

		const ruleIsActive = (link: HTMLAnchorElement, current: string) => {
			const rule = link.dataset.activeRule;
			const key = link.dataset.activeKey ?? '';
			if (rule === 'hash') return current === key;
			if (rule === 'path') return pathName === key;
			if (rule === 'prefix') return pathName.startsWith(key);
			if (rule === 'prefixOrHash') return pathName.startsWith(key) || current === link.dataset.activeHash;
			return false;
		};

		const applyActive = (current: string) => {
			for (const link of links) {
				const active = ruleIsActive(link, current);
				const kind = link.dataset.navKind;
				if (kind === 'dock') {
					const target = link.querySelector<HTMLElement>('[data-nav-active-target]');
					if (target) {
						target.classList.toggle('border-accent', active);
						target.classList.toggle('bg-accent', active);
						target.classList.toggle('text-neutral', active);
						target.classList.toggle('border-white/15', !active);
						target.classList.toggle('bg-white/10', !active);
						target.classList.toggle('text-white/80', !active);
						target.classList.toggle('group-hover/dock:border-white/30', !active);
						target.classList.toggle('group-hover/dock:bg-white/15', !active);
						target.classList.toggle('group-hover/dock:text-white', !active);
					}
				} else {
					link.classList.toggle('text-base-content', active);
					link.classList.toggle('underline', active);
					link.classList.toggle('text-muted-foreground', !active);
					link.classList.toggle('hover:text-base-content', !active);
				}

				if (!active) {
					link.removeAttribute('aria-current');
				} else if (link.dataset.activeRule === 'hash') {
					link.setAttribute('aria-current', 'location');
				} else if (link.dataset.activeRule === 'prefixOrHash' && !pathName.startsWith(link.dataset.activeKey ?? '')) {
					link.setAttribute('aria-current', 'location');
				} else {
					link.setAttribute('aria-current', 'page');
				}
			}
		};

		const syncCurrentSection = () => {
			const viewportAnchor = window.innerHeight * 0.4;
			let current = sections.find((section) => {
				const rect = section.getBoundingClientRect();
				return rect.top <= viewportAnchor && rect.bottom > viewportAnchor;
			});

			if (!current) {
				current = sections.reduce<{ section: HTMLElement; distance: number } | undefined>((nearest, section) => {
					const rect = section.getBoundingClientRect();
					const distance = Math.min(Math.abs(rect.top - viewportAnchor), Math.abs(rect.bottom - viewportAnchor));
					return !nearest || distance < nearest.distance ? { section, distance } : nearest;
				}, undefined)?.section;
			}

			applyActive(current?.id ?? 'header');
			frame = undefined;
		};

		const queueSync = () => {
			if (frame !== undefined) return;
			frame = window.requestAnimationFrame(syncCurrentSection);
		};

		syncCurrentSection();
		window.addEventListener('scroll', queueSync, { passive: true });
		window.addEventListener('resize', queueSync);
		window.addEventListener('hashchange', queueSync);
	}
</script>

<style>
	.dock {
		--font-scaler: 0.3;
		--dimensions-scaler: 0.35;
		--margin-scaler: 0.2;
		font-size: calc(var(--font-scaler) * 6rem);
	}

	.dock > div {
		height: calc(var(--dimensions-scaler) * 9rem);
		width: calc(var(--dimensions-scaler) * 9rem);
		flex-basis: auto;
	}

	.dock > div:hover {
		opacity: 100%;
	}

	.dock :global(svg) {
		stroke-width: 1.9;
	}

	@media (prefers-reduced-motion: no-preference) {
		.dock:hover {
			font-size: calc(var(--font-scaler) * 9rem);
			margin-top: calc(var(--margin-scaler) * -6rem);
		}

		.dock:hover > div {
			height: calc(var(--dimensions-scaler) * 13rem);
			width: calc(var(--dimensions-scaler) * 13rem);
			filter: saturate(1);
		}

		.dock:hover + .dock,
		.dock:has(+ .dock:hover) {
			font-size: calc(var(--font-scaler) * 8rem);
			margin-top: calc(var(--margin-scaler) * -3.5rem);
		}

		.dock:hover + .dock > div,
		.dock:has(+ .dock:hover) > div {
			height: calc(var(--dimensions-scaler) * 11rem);
			width: calc(var(--dimensions-scaler) * 11rem);
		}

		.dock:hover + .dock + .dock,
		.dock:has(+ .dock + .dock:hover) {
			font-size: calc(var(--font-scaler) * 7rem);
			margin-top: calc(var(--margin-scaler) * -2rem);
		}

		.dock:hover + .dock + .dock > div,
		.dock:has(+ .dock + .dock:hover) > div {
			height: calc(var(--dimensions-scaler) * 10rem);
			width: calc(var(--dimensions-scaler) * 10rem);
		}

		.dock:hover + .dock + .dock + .dock,
		.dock:has(+ .dock + .dock + .dock:hover) {
			font-size: calc(var(--font-scaler) * 6rem);
			margin-top: calc(var(--margin-scaler) * -1rem);
		}

		.dock:hover + .dock + .dock + .dock > div,
		.dock:has(+ .dock + .dock + .dock:hover) > div {
			height: calc(var(--dimensions-scaler) * 9rem);
			width: calc(var(--dimensions-scaler) * 9rem);
		}
	}
</style>
