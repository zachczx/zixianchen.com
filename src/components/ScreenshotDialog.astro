---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

export interface ScreenshotDialogImage {
	full: ImageMetadata;
	alt: string;
	caption: string;
}

interface Props {
	id: string;
	images: ScreenshotDialogImage[];
}

const { id, images } = Astro.props;
---

<dialog
	id={`${id}-dialog`}
	data-gallery-dialog
	aria-labelledby={`${id}-dialog-title`}
	class="m-auto max-h-[96vh] w-[min(96vw,96rem)] max-w-none overflow-hidden rounded-none bg-neutral-950 p-0 text-white ring-1 ring-white/20">
	<div class="flex items-center gap-3 border-b border-white/15 px-3 py-2 sm:px-4">
		<p
			id={`${id}-dialog-title`}
			data-gallery-title
			class="min-w-0 flex-1 truncate text-sm leading-normal font-semibold">
			{images[0]?.caption}
		</p>
		{
			images.length > 1 && (
				<span data-gallery-count class="text-xs text-white/60">
					1 of {images.length}
				</span>
			)
		}
		<form method="dialog">
			<button
				type="submit"
				class="grid size-11 cursor-pointer place-items-center border border-white/20 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:bg-white/20 disabled:cursor-not-allowed disabled:opacity-50"
				aria-label="Close full-size screenshot">
				<Icon name="x" class="size-5" />
			</button>
		</form>
	</div>

	<div
		data-gallery-stage
		class="gallery-stage relative grid max-h-[calc(96vh-3.6rem)] place-items-center overflow-auto bg-neutral-900">
		{
			images.map((image, index) => (
				<div
					data-gallery-slide
					data-gallery-index={index}
					class:list={{ hidden: index !== 0 }}
					aria-hidden={index !== 0}>
					<Image
						src={image.full}
						alt={image.alt}
						loading="lazy"
						width={Math.min(2400, image.full.width)}
						class="block max-h-[calc(96vh-3.6rem)] max-w-full object-contain"
					/>
				</div>
			))
		}

		{
			images.length > 1 && (
				<>
					<button
						type="button"
						data-gallery-prev
						class="absolute top-1/2 left-2 grid size-11 -translate-y-1/2 cursor-pointer place-items-center bg-neutral-950/85 transition-colors hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:bg-neutral-700 disabled:cursor-not-allowed disabled:opacity-50 sm:left-4"
						aria-label="Previous screenshot">
						<Icon name="chevron-left" class="size-6" />
					</button>
					<button
						type="button"
						data-gallery-next
						class="absolute top-1/2 right-2 grid size-11 -translate-y-1/2 cursor-pointer place-items-center bg-neutral-950/85 transition-colors hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:bg-neutral-700 disabled:cursor-not-allowed disabled:opacity-50 sm:right-4"
						aria-label="Next screenshot">
						<Icon name="chevron-right" class="size-6" />
					</button>
				</>
			)
		}
	</div>
</dialog>

<script>
	for (const gallery of document.querySelectorAll<HTMLElement>('[data-screenshot-gallery]')) {
		if (gallery.dataset.galleryInitialized === 'true') continue;
		gallery.dataset.galleryInitialized = 'true';

		const dialogId = gallery.dataset.galleryDialogId;
		const dialog = dialogId ? document.getElementById(dialogId) : undefined;
		if (!(dialog instanceof HTMLDialogElement)) continue;

		const slides = [...dialog.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
		const stage = dialog.querySelector<HTMLElement>('[data-gallery-stage]');
		const title = dialog.querySelector<HTMLElement>('[data-gallery-title]');
		const count = dialog.querySelector<HTMLElement>('[data-gallery-count]');
		let selectedIndex = 0;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const select = (index: number) => {
			if (slides.length === 0) return;
			if (dialog.open && stage && !reducedMotion.matches) {
				stage.classList.remove('is-changing');
				void stage.offsetWidth;
				stage.classList.add('is-changing');
				window.setTimeout(() => stage.classList.remove('is-changing'), 140);
			}
			selectedIndex = (index + slides.length) % slides.length;
			for (const [slideIndex, slide] of slides.entries()) {
				const selected = slideIndex === selectedIndex;
				slide.classList.toggle('hidden', !selected);
				slide.setAttribute('aria-hidden', String(!selected));
			}
			const trigger = gallery.querySelector<HTMLButtonElement>(`[data-gallery-open="${selectedIndex}"]`);
			const caption = trigger?.dataset.galleryCaption;
			if (title && caption) title.textContent = caption;
			if (count) count.textContent = `${selectedIndex + 1} of ${slides.length}`;
		};

		gallery.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			const trigger = event.target.closest<HTMLButtonElement>('[data-gallery-open]');
			if (!trigger) return;
			select(Number(trigger.dataset.galleryOpen ?? 0));
			dialog.showModal();
		});

		dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => select(selectedIndex - 1));
		dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => select(selectedIndex + 1));
		dialog.addEventListener('keydown', (event) => {
			if (slides.length < 2) return;
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				select(selectedIndex - 1);
			} else if (event.key === 'ArrowRight') {
				event.preventDefault();
				select(selectedIndex + 1);
			}
		});
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>

<style>
	dialog::backdrop {
		background: rgb(10 10 10 / 85%);
		backdrop-filter: blur(4px);
	}

	dialog[data-gallery-dialog] {
		opacity: 0;
		transform: scale(0.985);
		transition:
			opacity var(--motion-duration-overlay) var(--motion-ease-out),
			transform var(--motion-duration-overlay) var(--motion-ease-out);
		transition-behavior: allow-discrete;
	}

	dialog[data-gallery-dialog][open] {
		opacity: 1;
		transform: scale(1);
	}

	.gallery-stage {
		transition: opacity var(--motion-duration-short) var(--motion-ease-out);
	}

	.gallery-stage.is-changing {
		opacity: 0.45;
	}

	@starting-style {
		dialog[data-gallery-dialog][open] {
			opacity: 0;
			transform: scale(0.985);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		dialog[data-gallery-dialog],
		.gallery-stage {
			transform: none;
			transition: none;
		}
	}
</style>
