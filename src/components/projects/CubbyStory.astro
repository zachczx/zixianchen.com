	{section === 'timeline' && (
		<section id="household-day" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-14" aria-labelledby="timeline-title">
			<header class="mb-8 max-w-2xl">
				<h2 id="timeline-title" class="text-2xl font-bold sm:text-3xl">
					This is what it adds up to.
				</h2>
				<p class="text-base-content/75 mt-3">
					This illustration brings the separate features into a household day, from medicine in the morning to the
					evening routines. Cubby also has a Timeline in the app for recent records and upcoming events.
				</p>
			</header>
			<cubby-story-timeline>
				<div class="track-filters" role="group" aria-label="Filter the household timeline">
					<button type="button" data-filter="all" aria-pressed="true">
						All
					</button>
					{tracks.map((track) => (
						<button type="button" data-filter={track.id} aria-pressed="false">
							{track.label}
						</button>
					))}
				</div>
				<p class="timeline-hint">Choose a track, or scroll across to see all three.</p>
				<div
					class="timeline-viewport"
					role="region"
					aria-label="Example household day, Kid, Family, and You"
					tabindex="0">
					<div class="timeline-grid">
						{tracks.map((track) => (
							<div class="track-heading" data-track={track.id}>
								<span aria-hidden="true" />
								{track.label}
							</div>
						))}
						{scheduleHours.map((slot) =>
							tracks.map((track) => {
								const entry = slot[track.id];
								return (
									<div
										class:list={['timeline-cell', { 'empty-hour': !slot.kid && !slot.family && !slot.own }]}
										data-track={track.id}
										data-empty={!entry ? 'true' : undefined}>
										{entry && (
											<div
												class:list={[
													'timeline-entry',
													entry.colorScheme,
													{ 'has-photo': !!entry.photo, staggered: entry.stagger, 'compact-entry': !!entry.variant },
												]}>
												<span class="timeline-dot" aria-hidden="true" />
												<time datetime={entry.time}>{entry.timeLabel}</time>
												<h3>{entry.title}</h3>
												{entry.variant === 'limit' ? (
													<div class="limit-value">
														<span>{entry.metric}</span>
														<span class="limit-gauge" aria-hidden="true">
															{entry.gaugeLabel}
														</span>
													</div>
												) : entry.variant === 'task' ? (
													<p class="task-done">✓ Done</p>
												) : (
													<p>{entry.note}</p>
												)}
