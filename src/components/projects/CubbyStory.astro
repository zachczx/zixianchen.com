													<Image
														src={entry.photo}
														alt=""
														width={80}
														height={80}
														densities={[1, 2]}
														loading="lazy"
														class="entry-photo"
													/>
												)}
											</div>
										)}
									</div>
								);
							}),
						)}
					</div>
				</div>
			</cubby-story-timeline>
		</section>
	)}
</div>

<script>
	class CubbyStoryTimeline extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';
			const buttons = this.querySelectorAll<HTMLButtonElement>('[data-filter]');
			buttons.forEach((button) =>
				button.addEventListener('click', () => {
					const selected = button.dataset.filter ?? 'all';
					this.dataset.filter = selected;
					buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
					this.querySelectorAll<HTMLElement>('[data-track]').forEach((cell) => {
						cell.hidden = selected !== 'all' && cell.dataset.track !== selected;
					});
					const viewport = this.querySelector('.timeline-viewport');
					if (viewport) viewport.scrollLeft = 0;
				}),
			);
		}
	}
	if (!customElements.get('cubby-story-timeline')) customElements.define('cubby-story-timeline', CubbyStoryTimeline);
</script>

