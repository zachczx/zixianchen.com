	photo?: ImageMetadata;
	colorScheme: string;
	stagger?: boolean;
	variant?: string;
	metric?: string;
	gaugeLabel?: string;
}
interface Hour {
	hour: number;
	timeLabel: string;
	kid?: Entry;
	family?: Entry;
	own?: Entry;
