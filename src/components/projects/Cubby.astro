<script>
	// Feature write-ups are collapsed; open the one a link points at (thumbnails, Decisions links, shared URLs).
	const openTargetFeature = () => {
		const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
		if (target instanceof HTMLDetailsElement && target.classList.contains('cubby-feature')) target.open = true;
	};
	openTargetFeature();
	window.addEventListener('hashchange', openTargetFeature);
</script>

