---
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	max: string;
}

const { src, alt, max } = Astro.props;
---

<figure class:list={['mx-auto w-full', max]}>
	<img src={src.src} {alt} loading="lazy" decoding="async" class="border-neutral/20 block w-full border-2 shadow-sm" />
</figure>
