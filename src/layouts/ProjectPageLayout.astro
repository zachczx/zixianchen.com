---
import BaseLayout from './BaseLayout.astro';
import Nav from '$lib/Nav.svelte';
import WebsiteFooter from '$lib/WebsiteFooter.svelte';

interface Props {
	name: string;
	slug: string;
	description: string;
}

const { name, slug, description } = Astro.props;
---

<BaseLayout title={`${name} — Project Case Study | Zixian Chen`} {description} pathname={`/projects/${slug}`}>
	<Nav navCurrent="projects" pathName={Astro.url.pathname} />
	<div class="bg-base-200 grid min-h-dvh content-start">
		<section id="projects"><slot /></section>
		<WebsiteFooter />
	</div>
</BaseLayout>
