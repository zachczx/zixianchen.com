---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import dayjs from 'dayjs';
import ArticleToc from '../../components/ArticleToc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../layouts/BlogShell.astro';
import { resolveBlogSeriesForPost, validateBlogSeriesPosts } from '$lib/blogSeries';
import { resolveRelatedBlogPosts, validateRelatedBlogPosts } from '$lib/relatedBlogPosts';

interface Props {
	post: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const summaries = Object.fromEntries(
		posts.map((post) => [
			post.data.slug,
			{
				title: post.data.title,
				description: post.data.description,
				published: post.data.published,
				listed: post.data.listed,
			},
		]),
	);
	validateBlogSeriesPosts(summaries);
	validateRelatedBlogPosts(summaries);

	return posts
		.filter(({ data }) => data.published)
		.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const allPosts = await getCollection('blog');
const summaries = Object.fromEntries(
	allPosts.map((entry) => [
		entry.data.slug,
		{
			title: entry.data.title,
			description: entry.data.description,
			published: entry.data.published,
			listed: entry.data.listed,
		},
	]),
);
const { Content, headings: renderedHeadings } = await render(post);
const headings = renderedHeadings.filter(({ depth }) => depth === 2 || depth === 3);
const words = (post.body ?? '')
	.replace(/^---[\s\S]*?---/, '')
	.trim()
	.split(/\s+/)
	.filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
const series = resolveBlogSeriesForPost(post.data.slug, summaries);
const relatedPosts = resolveRelatedBlogPosts(post.data.slug, summaries);
const canonicalUrl = `https://zixianchen.com/blog/${post.data.slug}`;
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.date,
		dateModified: post.data.date_updated || post.data.date,
		articleSection: post.data.category,
		keywords: post.data.tags,
		mainEntityOfPage: canonicalUrl,
		author: {
			'@type': 'Person',
			name: 'Zixian Chen',
			url: 'https://zixianchen.com/',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zixianchen.com/' },
			{ '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://zixianchen.com/blog' },
			{ '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
		],
	},
];
---

<BaseLayout
	title={`${post.data.title} | Zixian Chen`}
	description={post.data.description}
	pathname={`/blog/${post.data.slug}`}
	type="article"
	noindex={post.data.listed === false}
	publishedTime={post.data.date}
	modifiedTime={post.data.date_updated || post.data.date}
	{structuredData}
	theme="dark">
	<meta slot="head" data-pagefind-meta="description[content]" content={post.data.description} />
	<meta slot="head" data-pagefind-meta="date[content]" content={post.data.date} />
	<meta slot="head" data-pagefind-meta="category[content]" content={post.data.category ?? ''} />
	<meta slot="head" data-pagefind-meta="tags[content]" content={post.data.tags.join(' / ')} />
	<meta slot="head" data-pagefind-filter="category[content]" content={post.data.category ?? ''} />

	<BlogShell pathName={Astro.url.pathname}>
		<div class="px-5 pb-3 sm:px-6 xl:px-14">
			<a
				href="/blog"
				class="text-base-content/50 hover:text-base-content font-mono text-sm tracking-tight transition-colors"
				>[back to main]</a
			>
		</div>
		<h1 class="px-5 py-1 text-2xl font-extrabold sm:px-6 sm:text-3xl lg:text-4xl xl:px-14 xl:text-5xl xl:font-black">
			{post.data.title}
		</h1>
		<p class="article-dek px-5 pt-4 text-base leading-relaxed sm:px-6 sm:text-lg xl:px-14">
			{post.data.description}
		</p>
		<div class="text-base-content/50 mt-3 px-5 font-mono text-sm tracking-tight sm:px-6 xl:px-14">
			<div class="flex flex-wrap items-baseline gap-x-1.5">
				<span class="uppercase">{dayjs(post.data.date).format('D MMM YYYY')}</span>
				{
					post.data.date_updated && (
						<span class="uppercase">[++ {dayjs(post.data.date_updated).format('D MMM YYYY')}]</span>
					)
				}
				<span class="text-base-content/30">/</span>
				<span>{readingTime} min read</span>
			</div>
			<div class="mt-1 flex flex-wrap items-center gap-x-1.5">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-[1em]"
					aria-hidden="true">
					<path
						d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"
					></path>
					<circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
				</svg>
				{
					post.data.tags.map((tag, index) => (
						<>
							{index > 0 && <span class="text-base-content/30">/</span>}
							<span>{tag}</span>
						</>
					))
				}
			</div>
			{
				series && (
					<div class="mt-2 flex flex-wrap items-baseline gap-x-1.5">
						<span>Series:</span>
						<a
							href="#series-navigation"
							class="text-base-content/80 decoration-accent hover:text-base-content font-semibold underline decoration-2 underline-offset-3 transition-colors">
							{series.title}
						</a>
						<span class="text-base-content/30">/</span>
						<span>
							Part {series.position} of {series.total}
						</span>
					</div>
				)
			}
		</div>

		{headings.length > 1 && <ArticleToc {headings} />}

		<article
			data-article-content
			data-pagefind-body={post.data.listed === false ? undefined : ''}
			class:list={[
				'blog-prose prose prose-a:font-semibold prose-a:decoration-1 prose-a:underline-offset-3 prose-a:hover:text-accent prose-blockquote:my-8 prose-blockquote:ms-8 prose-h2:text-2xl prose-h2:font-bold prose-p:leading-relaxed prose-li:leading-relaxed prose-p:my-6 prose-code:font-mono prose-pre:px-0 prose-pre:py-3 mt-4 w-full max-w-none px-5 sm:px-6 xl:mt-8 xl:px-14',
				{ 'numbered-paras': post.data.category === 'Work' },
			]}>
			<Content />
		</article>
		<div class="text-base-content/30 mt-10 px-5 text-center font-mono text-xs tracking-widest sm:px-6 xl:px-14">
			— END OF POST —
		</div>

		{
			series && (
				<nav
					id="series-navigation"
					aria-label={`${series.title} series`}
					class="border-base-content/10 mt-8 border-y px-5 py-6 sm:px-6 xl:px-14">
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
						<h2 class="text-xl font-bold">{series.title}</h2>
						<span class="text-base-content/50 font-mono text-sm">
							Part {series.position} of {series.total}
						</span>
					</div>
					<ol class="mt-4 grid gap-2">
						{series.posts.map((seriesPost) => (
							<li class="grid grid-cols-[2rem_1fr] items-baseline gap-2">
								<span class="text-base-content/40 text-right font-mono text-sm">{seriesPost.position}.</span>
								{seriesPost.current ? (
									<span class="font-semibold" aria-current="page">
										{post.data.title}
										<span class="text-base-content/45 ml-1 font-mono text-xs font-normal">You are here</span>
									</span>
								) : seriesPost.published ? (
									<a
										href={`/blog/${seriesPost.slug}`}
										class="decoration-accent hover:text-accent font-semibold underline decoration-1 underline-offset-3 transition-colors">
										{seriesPost.title}
									</a>
								) : (
									<span class="text-base-content/45 font-mono text-sm">Coming soon</span>
								)}
							</li>
						))}
					</ol>
					{(series.previous || series.next) && (
						<div class="border-base-content/10 mt-5 flex flex-wrap items-center justify-between gap-3 border-t pt-4 font-mono text-sm">
							{series.previous ? (
								<a
									href={`/blog/${series.previous.slug}`}
									class="hover:text-accent focus-visible:outline-accent inline-flex items-center gap-1.5 font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
									← Part {series.previous.position}
								</a>
							) : (
								<span />
							)}
							{series.next && (
								<a
									href={`/blog/${series.next.slug}`}
									class="hover:text-accent focus-visible:outline-accent inline-flex items-center gap-1.5 font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
									Continue to Part {series.next.position} →
								</a>
							)}
						</div>
					)}
				</nav>
			)
		}

		{
			relatedPosts.length > 0 && (
				<nav aria-label="Related posts" class="border-base-content/10 mt-8 border-y px-5 py-6 sm:px-6 xl:px-14">
					<h2 class="text-xl font-bold">Related notes</h2>
					<ul class="divide-base-content/10 mt-3 divide-y">
						{relatedPosts.map((relatedPost) => (
							<li class="py-3 first:pt-0 last:pb-0">
								<a
									href={`/blog/${relatedPost.slug}`}
									class="decoration-accent hover:text-accent focus-visible:outline-accent font-semibold underline decoration-1 underline-offset-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
									{relatedPost.title}
								</a>
								<p class="text-base-content/60 mt-1 text-sm leading-relaxed">{relatedPost.description}</p>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</BlogShell>
</BaseLayout>

<style>
	h1 {
		min-width: 0;
		letter-spacing: -0.015em;
		overflow-wrap: anywhere;
		text-wrap: pretty;
	}

	.article-dek {
		max-width: 44rem;
		color: var(--blog-night-muted);
		text-wrap: pretty;
	}

	article.blog-prose :global(h2) {
		margin-top: 2.75rem;
		border-top: 1px solid var(--blog-night-rule);
		padding-top: 1rem;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	article.blog-prose > :global(:first-child) {
		margin-top: 0;
	}

	article.blog-prose :global(h3) {
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}

	article.blog-prose :global(h3 + p) {
		margin-top: 0;
	}

	article.blog-prose :global(h2:has(+ h3)) {
		margin-bottom: 0;
	}

	article.blog-prose :global(h2 + h3) {
		margin-top: 1rem;
	}

	article.blog-prose :global(blockquote) {
		border-color: var(--blog-night-accent);
		background: color-mix(in oklab, var(--blog-night-surface) 72%, transparent);
		padding-block: 0.75rem;
		padding-inline-end: 1rem;
	}

	article.numbered-paras {
		counter-reset: para;
	}

	article.numbered-paras > :global(p) {
		counter-increment: para;
	}

	article.numbered-paras > :global(p)::before {
		content: counter(para) '.';
		margin-inline-end: 0.5em;
		font-family: var(--font-mono);
		font-size: 0.85em;
		opacity: 0.75;
	}

	article :global(ul),
	article :global(ol) {
		padding-left: 2em;
	}

	article :global(li)::marker {
		font-family: var(--font-mono);
		font-size: 0.85em;
		opacity: 0.75;
	}

	@media (min-width: 40rem) {
		article :global(ul),
		article :global(ol) {
			padding-left: 2.5em;
		}
	}

	@media (min-width: 80rem) {
		article :global(ul),
		article :global(ol) {
			padding-left: 3em;
		}
	}
</style>
