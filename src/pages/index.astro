---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import dayjs from 'dayjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeCanvas from '../components/CodeCanvas.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import WebsiteFooter from '../components/WebsiteFooter.astro';
import Projects from '../components/Projects.astro';
import Moon from '$lib/assets/luke-stackpoole-TRXSkmJb40c-unsplash.webp';
import CrayonPortrait from '$lib/assets/crayon-drawing.webp';
import { jobs } from '../routes/jobs';

const posts = (await getCollection('blog', ({ data }) => data.published && data.listed !== false))
	.map(({ data }) => data)
	.sort((first, second) => new Date(second.date).getTime() - new Date(first.date).getTime())
	.slice(0, 3);
---

<BaseLayout
	title="Zixian Chen | Public-Sector Tech by Day, Questionable Side Projects by Night"
	description="Public-sector tech by day, questionable side projects by night. Zixian Chen builds useful things, writes about what went wrong, and occasionally codes by hand."
	pathname="/">
	<Nav navCurrent="header" pathName="/" trackSections />
	<main class="bg-base-200 grid min-h-dvh justify-items-center 2xl:overflow-x-clip">
		<header id="header" class="navItem grid min-h-dvh w-full place-items-center px-4 py-12 pb-24 xl:pb-28">
			<div class="bg-base-200 grid w-full content-center justify-items-center gap-7">
				<div class="grid justify-items-center" style="view-transition-name: logo">
					<h1 class="sr-only">Zixian Chen</h1>
					<div class="relative my-1 size-[clamp(11rem,40vw,24rem)] lg:my-2" aria-hidden="true">
						<CodeCanvas glyphMask="jost-z" />
					</div>
				</div>
				<div class="grid justify-items-center gap-3 text-center">
					<a
						href="#projects"
						class="group/hero-link text-base-content/61 hover:text-base-content focus-visible:outline-accent grid min-h-11 content-center justify-items-center gap-0.5 px-3 text-sm font-medium tracking-[0.08em] no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
						<span>Side projects</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-4 transition-transform duration-200 group-hover/hero-link:translate-y-0.5 group-focus-visible/hero-link:translate-y-0.5"
							aria-hidden="true">
							<path d="m6 9 6 6 6-6"></path>
						</svg>
					</a>
				</div>
			</div>
		</header>

		<section
			id="about"
			aria-labelledby="about-heading"
			class="navItem bg-base-200 grid w-full justify-items-center px-4 py-20 lg:py-32">
			<div class="border-base-content/15 bg-base-100 w-full max-w-3xl border">
				<div class="border-base-content/15 flex items-baseline justify-between border-b px-6 py-5 sm:px-8">
					<h2 id="about-heading" class="text-2xl font-bold tracking-tight lg:text-3xl">Interests</h2>
				</div>
				<div class="sm:flex">
					<div class="border-base-content/10 border-b px-4 py-4">
						<Image
							src={CrayonPortrait}
							alt="Crayon portrait of Zixian"
							class="border-base-content/15 w-32 border sm:w-96"
						/>
					</div>
					<dl class="divide-base-content/10 divide-y px-4">
						<div class="grid gap-x-8 gap-y-1.5 py-4">
							<dt class="text-muted-foreground text-xs tracking-[0.18em] uppercase sm:pt-1">Stack</dt>
							<dd class="text-base-content/80 text-sm leading-relaxed lg:text-base">
								Go, TypeScript, and a bit of Zig.
							</dd>
						</div>
						<div class="grid gap-x-8 gap-y-1.5 py-4">
							<dt class="text-muted-foreground text-xs tracking-[0.18em] uppercase sm:pt-1">Since</dt>
							<dd class="text-base-content/80 text-sm leading-relaxed lg:text-base">
								2000 on/off. Back in the Frontpage, XHTML, PHP days.
							</dd>
						</div>
						<div class="grid gap-x-8 gap-y-1.5 py-4">
							<dt class="text-muted-foreground text-xs tracking-[0.18em] uppercase sm:pt-1">Now</dt>
							<dd class="text-base-content/80 text-sm leading-relaxed lg:text-base">
								Building a home admin app. Trying to write organic, free-range code by hand. It's tempting to let Claude
								Code and OpenCode do it automatically but it doesn't feel the same.
							</dd>
						</div>
						<div class="grid gap-x-8 gap-y-1.5 py-4">
							<dt class="text-muted-foreground text-xs tracking-[0.18em] uppercase sm:pt-1">Offline</dt>
							<dd class="text-base-content/80 text-sm leading-relaxed lg:text-base">
								Building PCs (love bargains, hate cable management). Learning about product design, business, and
								entrepreneurship.
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<section
			aria-labelledby="jobs"
			class="navItem bg-base-200 grid min-h-dvh w-full justify-items-center px-4 py-20 lg:py-28">
			<div class="grid w-full max-w-250 content-start gap-y-12 lg:gap-y-24">
				<div class="justify-self-start">
					<h2 id="jobs" class="text-5xl font-extrabold sm:text-6xl lg:text-9xl">Day</h2>
					<p class="text-base-content/65 mt-3 max-w-xl text-sm leading-relaxed lg:text-base">
						Public sector tech, policy, comms, and service delivery roles.
					</p>
					<a
						href="https://www.linkedin.com/in/zixianchen/"
						target="_blank"
						rel="me noopener noreferrer"
						aria-label="LinkedIn (opens in a new tab)"
						class="border-base-content/20 text-base-content/70 hover:border-base-content/40 hover:bg-base-100 hover:text-base-content focus-visible:outline-accent mt-6 inline-flex min-h-11 items-center gap-2 border px-3.5 text-sm font-semibold no-underline transition-[border-color,background-color,color] focus-visible:outline-2 focus-visible:outline-offset-2">
						LinkedIn
						<Icon name="external-link" class="size-3.5 opacity-60" />
					</a>
				</div>
				<div class="grid content-start gap-y-10 lg:gap-y-16">
					{
						jobs.map((job) => (
							<div class="grid gap-y-1 lg:grid-cols-[5rem_minmax(0,1fr)]">
								<div class="text-base-content/70 items-baseline text-sm lg:pt-1.5 lg:text-base">{job.year}</div>
								<div>
									<h3 class="text-lg font-bold lg:text-2xl">{job.title}</h3>
									<p class="text-base-content/70 text-sm leading-relaxed lg:text-base">{job.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<div
			data-nav-tone-section="dark"
			class="text-night-content bg-night-background grid w-full content-start justify-items-center lg:grid-cols-5">
			<div class="grid w-full justify-items-center pt-8 lg:col-span-3 lg:pt-28">
				<section
					id="projects"
					aria-labelledby="projects-heading"
					class="navItem grid w-full max-w-250 justify-items-start px-4 pb-8 lg:grid-cols-3 lg:justify-self-end lg:pb-28">
					<div class="justify-self-start pb-8 lg:col-span-3 lg:pb-24">
						<h2 id="projects-heading" class="text-5xl font-extrabold sm:text-6xl lg:text-9xl">Night</h2>
						<p class="text-night-content/65 mt-3 max-w-xl text-sm leading-relaxed lg:text-base">
							Personal tools, experiments, and small products built outside the day job.
						</p>
						<a
							href="https://github.com/zachczx?tab=repositories"
							target="_blank"
							rel="me noopener noreferrer"
							aria-label="GitHub (opens in a new tab)"
							class="text-night-content/70 hover:text-night-content focus-visible:outline-accent border-night-overlay/20 hover:border-night-overlay/40 hover:bg-night-overlay/5 mt-6 inline-flex min-h-11 items-center gap-2 border px-3.5 text-sm font-semibold no-underline transition-[border-color,background-color,color] focus-visible:outline-2 focus-visible:outline-offset-2">
							GitHub
							<Icon name="external-link" class="size-3.5 opacity-60" />
						</a>
					</div>

					<div
						class="grid w-full content-start justify-items-center gap-y-8 text-center lg:col-span-3 lg:grid-cols-1 lg:justify-items-start lg:text-start">
						<Projects />
					</div>
				</section>
			</div>
			<div
				id="moon"
				class="hidden h-full w-full overflow-hidden bg-black lg:col-span-2 lg:grid"
				style={`background-image:url(${Moon.src}); background-size: cover; background-position: center;`}>
			</div>
			<section
				id="musings"
				aria-labelledby="musings-heading"
				class="navItem grid w-full justify-items-center px-4 py-20 lg:col-span-5 lg:py-32">
				<div class="border-night-overlay/15 bg-night-overlay/5 w-full max-w-3xl border">
					<div class="border-night-overlay/15 border-b px-6 py-5 sm:px-8">
						<h2 id="musings-heading" class="text-2xl font-bold tracking-tight lg:text-3xl">Blog</h2>
						<p class="text-night-content/55 mt-2 text-sm leading-relaxed lg:text-base">Recent writing.</p>
					</div>
					<div class="divide-night-overlay/10 divide-y px-6 sm:px-8">
						{
							posts.map((post) => (
								<a
									href={`/blog/${post.slug}`}
									class="group focus-visible:outline-accent grid gap-x-8 gap-y-1.5 py-5 focus-visible:outline-2 focus-visible:outline-offset-[-2px] sm:grid-cols-[7rem_1fr]">
									<span class="text-night-muted-foreground font-mono text-xs tracking-[0.18em] uppercase sm:pt-1.5">
										{dayjs(post.date).format('D MMM YYYY')}
									</span>
									<span class="block">
										<span class="decoration-accent block leading-snug font-bold decoration-2 underline-offset-4 transition-colors group-focus-within:underline group-hover:underline lg:text-lg">
											{post.title}
										</span>
										<span class="text-night-muted-foreground mt-1.5 flex flex-wrap gap-x-1.5 font-mono text-xs tracking-tight">
											{post.tags.map((tag, index) => (
												<>
													{index > 0 && <span class="text-night-content/25">/</span>}
													<span>{tag}</span>
												</>
											))}
										</span>
									</span>
								</a>
							))
						}
						<a
							href="/blog"
							class="text-night-content/60 hover:text-night-content flex items-center justify-end gap-1 py-5 font-mono text-sm tracking-tight transition-colors">
							All posts
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="size-3.5"
								aria-hidden="true">
								<path d="m9 18 6-6-6-6"></path>
							</svg>
						</a>
					</div>
				</div>
			</section>
			<div class="lg:col-span-5">
				<WebsiteFooter />
			</div>
		</div>
	</main>
</BaseLayout>
