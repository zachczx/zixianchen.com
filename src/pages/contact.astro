---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import WebsiteFooter from '../components/WebsiteFooter.astro';
---

<BaseLayout title="Zixian Chen - Message Me" description="Send Zixian a message." pathname="/contact">
	<div class="contact-page bg-base-200 grid min-h-dvh grid-rows-[auto_1fr_auto]">
		<Nav navCurrent="" pathName={Astro.url.pathname} />
		<main class="contact-main flex w-full items-center px-4 pt-24 pb-10 sm:px-6 sm:pt-28 lg:px-8 lg:pb-16">
			<section class="contact-section mx-auto w-full max-w-2xl">
				<div class="contact-panel border-base-content/15 bg-base-100 rounded-2xl border p-5 sm:p-8 lg:p-10">
					<h1 class="contact-title mb-8 text-5xl font-bold">Say Something</h1>
					<form id="contact-form" class="relative grid w-full gap-y-6">
						<div
							class="pointer-events-none absolute size-px overflow-hidden whitespace-nowrap [clip-path:inset(50%)] [clip:rect(0,0,0,0)]"
							aria-hidden="true">
							<label for="contact-website">Website</label>
							<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
						</div>
						<div class="contact-fields grid gap-6">
							<div class="contact-field grid gap-2">
								<label
									for="contact-name"
									class="contact-label text-base-content/65 font-mono text-xs font-semibold tracking-[0.14em] uppercase"
									>Name<span class="contact-required" aria-hidden="true">*</span></label
								>
								<div class="contact-input-shell input input-lg input-bordered flex w-full items-center">
									<input
										id="contact-name"
										type="text"
										class="contact-input grow"
										name="name"
										placeholder="Your name"
										autocomplete="name"
										maxlength="100"
										required
									/>
								</div>
							</div>
							<div class="contact-field grid gap-2">
								<label
									for="contact-email"
									class="contact-label text-base-content/65 font-mono text-xs font-semibold tracking-[0.14em] uppercase"
									>Email<span class="contact-required" aria-hidden="true">*</span></label
								>
								<div class="contact-input-shell input input-lg input-bordered flex w-full items-center">
									<input
										id="contact-email"
										type="email"
										name="email"
										class="contact-input grow"
										placeholder="you@example.com"
										autocomplete="email"
										maxlength="254"
										required
									/>
								</div>
							</div>
						</div>
						<div class="contact-field grid gap-2">
							<label
								for="contact-message"
								class="contact-label text-base-content/65 font-mono text-xs font-semibold tracking-[0.14em] uppercase"
								>Message<span class="contact-required" aria-hidden="true">*</span></label
							>
							<textarea
								id="contact-message"
								name="message"
								placeholder="What’s up?"
								class="contact-control textarea textarea-bordered textarea-lg w-full"
								maxlength="3000"
								required
								rows="5"></textarea>
						</div>
						<div class="contact-actions border-base-content/10 grid gap-4 border-t pt-6">
							<button
								id="contact-submit"
								type="submit"
								class="contact-submit btn btn-neutral btn-lg text-base-100 w-full text-base"
								aria-busy="false">
								<span id="contact-spinner" class="loading loading-dots loading-md text-base-100 hidden"></span>
								<span id="contact-submit-label">Send message</span>
							</button>
							<p
								id="contact-success"
								aria-live="polite"
								tabindex="-1"
								class="contact-status contact-status-success hidden text-sm">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="me-1 mb-1 inline size-4"
									aria-hidden="true">
									<path d="M20 6 9 17l-5-5"></path>
								</svg>
								Message sent successfully.
							</p>
							<p
								id="contact-error"
								aria-live="polite"
								tabindex="-1"
								class="contact-status contact-status-error hidden text-sm">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="me-1 mb-1 inline size-4"
									aria-hidden="true">
									<circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line
										x1="12"
										x2="12.01"
										y1="16"
										y2="16"></line>
								</svg>
								That didn’t go through. Try again, or
								<a
									href="https://www.linkedin.com/in/zixianchen/"
									class="focus-visible:outline-accent font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2"
									>message me on LinkedIn</a
								>.
							</p>
						</div>
					</form>
				</div>
			</section>
		</main>
		<WebsiteFooter />
	</div>
</BaseLayout>

<style>
	/* Hallmark · component: contact form · genre: editorial · theme: incumbent civic slate
	 * pre-emit critique: P5 H5 E4 S5 R5 V4
	 * states: default · hover · focus · active · disabled · loading · error · success
	 * contrast: pass (40–41) · responsive: pass (34, 49, 50–57)
	 */
	.contact-page {
		--contact-rule: color-mix(in oklab, var(--color-base-content) 16%, transparent);
		--contact-muted: color-mix(in oklab, var(--color-base-content) 78%, transparent);
		--contact-success-ink: color-mix(in oklab, var(--color-success) 45%, var(--color-base-content));
	}

	.contact-title {
		max-width: none;
		min-width: 0;
		overflow-wrap: anywhere;
		font-size: clamp(3rem, 9vw + 1rem, 4.75rem);
		line-height: 0.96;
		letter-spacing: -0.05em;
	}

	.contact-panel {
		min-width: 0;
		border-color: var(--contact-rule);
	}

	.contact-label {
		color: var(--contact-muted);
		letter-spacing: 0.14em;
	}

	.contact-required {
		color: var(--color-primary);
	}

	.contact-input-shell,
	.contact-control {
		border: 1px solid var(--contact-rule);
		background-color: var(--color-base-100);
		color: var(--color-base-content);
		outline: 2px solid transparent;
		outline-offset: 2px;
		transition:
			background-color var(--motion-duration-short) var(--motion-ease-out),
			border-color var(--motion-duration-short) var(--motion-ease-out),
			transform var(--motion-duration-micro) var(--motion-ease-out);
	}

	.contact-input-shell {
		min-height: 3.25rem;
		padding-inline: 1rem;
	}

	.contact-input-shell:focus-within,
	.contact-control:focus-visible {
		border-color: var(--color-base-content);
	}

	.contact-input:focus-visible,
	.contact-control:focus-visible {
		outline-color: var(--color-primary);
	}

	.contact-input {
		min-width: 0;
		border: 0;
		background: transparent;
		color: inherit;
		outline: 2px solid transparent;
		outline-offset: 2px;
	}

	.contact-input::placeholder,
	.contact-control::placeholder {
		color: var(--contact-muted);
		opacity: 1;
	}

	.contact-control {
		min-height: 10rem;
		resize: vertical;
	}

	.contact-input-shell:has(.contact-input:user-invalid),
	.contact-control:user-invalid {
		border-color: var(--color-warning);
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-input-shell:hover,
		.contact-control:hover {
			background-color: var(--color-base-200);
		}

		.contact-submit:hover {
			border-color: var(--color-primary);
			background-color: var(--color-primary);
			color: var(--color-neutral);
			transform: translateY(-1px);
		}
	}

	.contact-input-shell:active,
	.contact-control:active {
		transform: translateY(1px);
	}

	.contact-input:disabled,
	.contact-control:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.contact-input-shell:has(.contact-input:disabled),
	.contact-control:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.contact-submit {
		min-height: 3.25rem;
		border: 1px solid var(--color-neutral);
		border-radius: 0.75rem;
		white-space: nowrap;
		transition:
			background-color var(--motion-duration-short) var(--motion-ease-out),
			border-color var(--motion-duration-short) var(--motion-ease-out),
			color var(--motion-duration-short) var(--motion-ease-out),
			transform var(--motion-duration-micro) var(--motion-ease-out);
	}

	.contact-submit:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.contact-submit:active {
		transform: translateY(1px);
	}

	.contact-submit:disabled {
		cursor: not-allowed;
		opacity: 0.65;
		transform: none;
	}

	.contact-submit[aria-busy='true'] {
		cursor: wait;
	}

	.contact-status {
		margin: 0;
		padding-inline-start: 0.75rem;
		border-inline-start: 2px solid currentColor;
		color: var(--contact-muted);
		line-height: 1.5;
	}

	.contact-status:not(.hidden) {
		display: block;
	}

	.contact-status-success {
		color: var(--contact-success-ink);
	}

	.contact-status-error {
		color: var(--color-warning);
	}

	.contact-panel:has(#contact-success:not(.hidden)) {
		border-color: var(--contact-success-ink);
	}

	.contact-panel:has(#contact-error:not(.hidden)) {
		border-color: var(--color-warning);
	}

	.contact-status a {
		color: inherit;
	}

	@media (min-width: 48rem) {
		.contact-fields {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.contact-main {
			padding-block-start: 8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-input-shell,
		.contact-control,
		.contact-submit {
			transition-duration: 150ms;
		}

		.contact-input-shell:active,
		.contact-control:active,
		.contact-submit:hover,
		.contact-submit:active {
			transform: none;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const submit = document.querySelector<HTMLButtonElement>('#contact-submit');
	const spinner = document.querySelector<HTMLElement>('#contact-spinner');
	const submitLabel = document.querySelector<HTMLElement>('#contact-submit-label');
	const success = document.querySelector<HTMLElement>('#contact-success');
	const error = document.querySelector<HTMLElement>('#contact-error');

	function setSubmitting(isSubmitting: boolean) {
		if (!submit || !spinner || !submitLabel) return;
		submit.disabled = isSubmitting;
		submit.setAttribute('aria-busy', String(isSubmitting));
		spinner.classList.toggle('hidden', !isSubmitting);
		submitLabel.textContent = isSubmitting ? 'Sending...' : 'Send message';
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		success?.classList.add('hidden');
		error?.classList.add('hidden');
		setSubmitting(true);

		try {
			const response = await fetch('/api/contact', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					Accept: 'application/json',
				},
				body: JSON.stringify(Object.fromEntries(new FormData(form))),
			});
			if (!response.ok) throw new Error('Message could not be sent.');

			form.reset();
			success?.classList.remove('hidden');
			success?.focus();
		} catch {
			error?.classList.remove('hidden');
			error?.focus();
		} finally {
			setSubmitting(false);
		}
	});
</script>
