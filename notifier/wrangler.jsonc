{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "zixianchen-blog-notifier",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"workers_dev": true,
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"RSS_URL": "https://zixianchen.com/rss.xml"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zixianchen-blog-notifier",
			"database_id": "25196238-e145-40bf-bde5-f70224d0e771"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATIONS",
				"queue": "zixianchen-blog-notifier-notifications"
			}
		],
		"consumers": [
			{
				"queue": "zixianchen-blog-notifier-notifications",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"max_concurrency": 1
			}
		]
	}
}
