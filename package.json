{
	"name": "svelte-zixianchen",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.0",
		"npm": ">=10.0"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pagefind --site build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:notifier": "pnpm --filter @zixianchen/blog-notifier check",
		"test:notifier": "pnpm --filter @zixianchen/blog-notifier test",
		"deploy:notifier": "pnpm --filter @zixianchen/blog-notifier deploy",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.121",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.28.0",
		"@shikijs/transformers": "^4.4.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.1.2",
		"bits-ui": "^2.18.1",
		"daisyui": "^5.7.16",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"super-sitemap": "^2.0.6",
		"svelte-check": "^4.7.4",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.0",
		"vite-plugin-pagefind": "^1.1.1"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@poppanator/sveltekit-svg": "7.0.0",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@tailwindcss/vite": "4.3.3",
		"animejs": "^4.5.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.21",
		"gsap": "^3.15.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.4.2",
		"svelte": "5.56.8",
		"tailwind-merge": "^3.6.0"
	}
}
